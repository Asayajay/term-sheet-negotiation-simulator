# Copy this file to .env and fill in your own values. Never commit the real .env.

# Required for real (non-mock) negotiations. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Set to "true" to force every negotiation to run in mock mode (canned
# responses, zero API cost) regardless of what the frontend/API requests.
# Useful for a shared demo deployment you don't want to accidentally bill.
MOCK_MODE=false

# Postgres connection string used by the backend. docker-compose sets this
# automatically for the containerized setup; override for local dev against
# a different database. Defaults to a local SQLite file if unset.
DATABASE_URL=postgresql://negotiator:negotiator@localhost:5432/negotiations
